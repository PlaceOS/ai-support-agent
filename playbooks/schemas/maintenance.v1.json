{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeos.com/schemas/ai-support-agent/maintenance.v1.json",
  "title": "PlaceOS AI Support Agent maintenance procedure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "mode", "schedule", "scope", "diagnostics", "deduplication_window_seconds", "reporting"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "maintenance-procedure.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "const": "maintenance" },
    "schedule": {
      "type": "object", "additionalProperties": false, "required": ["cron"],
      "properties": { "cron": { "type": "string", "minLength": 1 }, "timezone": { "type": "string", "default": "UTC" } }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {
        "kind": { "const": "modules" },
        "filter": { "enum": ["all", "runtime_errors"], "default": "all" },
        "module_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "system_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
      }
    },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^diagnostic:[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$" } },
    "deduplication_window_seconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
    "reporting": {
      "type": "object", "additionalProperties": false,
      "properties": { "deliver_reports": { "type": "boolean", "default": true } }
    }
  }
}
