{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeos.com/schemas/ai-support-agent/escalation.v1.json",
  "title": "PlaceOS AI Support Agent escalation procedure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "mode", "matches", "owner_queue", "response_sla_minutes", "required_artefacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "escalation-procedure.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "const": "escalation" },
    "priority": { "type": "integer", "default": 0 },
    "matches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "severities": { "type": "array", "items": { "enum": ["info", "warning", "error", "critical"] }, "default": [] },
        "classifications": { "type": "array", "items": { "type": "string" }, "default": [] },
        "confidence_below": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_age_seconds": { "type": "integer", "minimum": 0, "default": 0 },
        "fallback": { "type": "boolean", "default": false }
      }
    },
    "owner_queue": { "type": "string", "minLength": 1 },
    "response_sla_minutes": { "type": "integer", "minimum": 1, "maximum": 10080 },
    "required_artefacts": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["diagnostic_report", "investigation_plan", "evidence", "agent_decision", "verification_history"] }
    }
  }
}
