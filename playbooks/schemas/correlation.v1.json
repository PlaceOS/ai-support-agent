{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeos.com/schemas/ai-support-agent/correlation.v1.json",
  "title": "PlaceOS AI Support Agent correlation policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "default", "grouping", "rules", "trends"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "correlation-policy.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "default": { "type": "boolean" },
    "grouping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["tenant_id", "system_id", "module_id", "classification"] }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeated_incidents", "flapping", "noisy_signals"],
      "properties": {
        "repeated_incidents": { "$ref": "#/$defs/rule" },
        "flapping": { "$ref": "#/$defs/rule" },
        "noisy_signals": { "$ref": "#/$defs/rule" }
      }
    },
    "trends": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_window_seconds", "maximum_window_seconds", "top_modules_limit"],
      "properties": {
        "default_window_seconds": { "type": "integer", "minimum": 300, "maximum": 2678400 },
        "maximum_window_seconds": { "type": "integer", "minimum": 300, "maximum": 2678400 },
        "top_modules_limit": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "window_seconds", "threshold"],
      "properties": {
        "enabled": { "type": "boolean" },
        "window_seconds": { "type": "integer", "minimum": 60, "maximum": 2678400 },
        "threshold": { "type": "integer", "minimum": 2, "maximum": 10000 }
      }
    }
  }
}
