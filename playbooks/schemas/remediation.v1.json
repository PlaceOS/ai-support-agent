{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeos.com/schemas/ai-support-agent/remediation.v1.json",
  "title": "PlaceOS AI Support Agent remediation procedure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "mode", "matches", "proposal"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "remediation-procedure.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "const": "remediation" },
    "priority": { "type": "integer", "default": 0 },
    "matches": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classifications"],
      "properties": {
        "classifications": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        },
        "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 0 },
        "required_context": {
          "type": "array",
          "items": { "enum": ["tenant_id", "system_id", "module_id", "module_name", "module_index"] },
          "default": []
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "risk_level", "approval_required", "policy_basis", "verification"],
      "properties": {
        "action": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "approval_required": { "const": true },
        "policy_basis": { "type": "string", "minLength": 1 },
        "verification": {
          "type": "string",
          "pattern": "^verification:[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$"
        }
      }
    }
  }
}
