{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeos.com/schemas/ai-support-agent/workflow.v1.json",
  "title": "PlaceOS AI Support Agent workflow playbook",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "entrypoint", "default", "stages"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "workflow.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "entrypoint": { "type": "string" },
    "default": { "type": "boolean" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "enum": ["diagnostic", "remediation", "escalation", "report", "escalated"] },
        "procedures": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(diagnostic|remediation|escalation):[a-z0-9]+(?:-[a-z0-9]+)*@[1-9][0-9]*$" },
          "default": []
        },
        "transitions": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {}
        },
        "terminal": { "type": "boolean", "default": false }
      }
    }
  }
}
