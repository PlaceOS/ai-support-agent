{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://placeos.com/schemas/ai-support-agent/verification.v1.json",
  "title": "PlaceOS AI Support Agent verification procedure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "name", "mode", "checks", "policy"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "verification-procedure.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "const": "verification" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tool", "criterion"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "tool": {
            "enum": ["module_details", "module_state", "module_error_logs", "debug_or_error_logs", "system_details", "core_loaded_processes", "module_settings", "driver_details", "system_modules", "search_consistency", "cluster_status", "platform_version"]
          },
          "criterion": { "enum": ["tool_succeeded", "evidence_present", "runtime_error_cleared"] },
          "io_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 60, "default": 10 },
          "requires": {
            "type": "array",
            "items": { "enum": ["tenant_id", "system_id", "module_id", "module_name", "module_index"] },
            "default": []
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_interval_seconds", "max_attempts", "timeout_seconds", "failure_outcome"],
      "properties": {
        "retry_interval_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 604800 },
        "failure_outcome": { "const": "escalate" }
      }
    }
  }
}
