{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report.v1.json",
  "title": "Incident Report Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "subject", "body"],
  "properties": {
    "schema_version": {
      "const": "report-template.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    }
  }
}
